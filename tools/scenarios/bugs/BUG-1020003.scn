scenario 2
tick_rate 60
# Owner bug list 2026-10-20, item 3 (numbered 1020003 here): hover
# effects showed over the UI panels.
# Game panels cover the world, its hover included: with the inventory
# open, the pointer over the panel must not hover the world under it (no
# highlight, no name label), while the same object is hovered when no
# panel covers it.
name bug-1020003-hover-under-panel
seed 7
end 100
char class 1
# A stash object up and to the right of the player.
at 1 poke object 267 @x+10 @y-10
# No panel: the pointer on the object hovers it.
at 20 input move 720 260
at 30 check client.hover != null
# Open the inventory: the view shifts left and the object now lies under
# the panel; the pointer on that spot is over the panel, not the world.
at 40 input key i
at 50 check ui.open(inventory)
at 60 input move 520 260
at 70 check client.hover == null
at 90 check client.hover == null
